-output { 4 O1 } \
-from { \
   { 4 add_13_24 : UADD { { add_13_24.A } { 'b1 ZERO 4 } } } \
   { O1 = { add_13_24.1 } } } \
-to { \
   { 4 inc_add_13_24_1 : UINC { { add_13_24.A } { 'b1 ZERO 4 } } } \
   { O1 = { inc_add_13_24_1.1 } } }

